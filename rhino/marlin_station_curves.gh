  <Object type="GH_Component" name="C# Script" InstanceGuid="e1f2a3b4-bbbb-cccc-dddd-eeeeffff0000">
    <Fields>
      <Name>Station Curves Generator</Name>
      <NickName>Stations</NickName>
      <Description>Generates parametric station curves from vessel parameters</Description>
      <Category>MARLIN</Category>
      <SubCategory>Geometry</SubCategory>
      <InstanceDescription>Builds station cross-sections as NURBS curves</InstanceDescription>
      <MutualData>
        <InputParameters>
          <Parameter InstanceGuid="f2a3b4c5-cccc-dddd-eeee-ffff00001111" Name="loa" NickName="loa" Description="Length overall" Optional="False" Access="Item" TypeHint="System.Double" />
          <Parameter InstanceGuid="a3b4c5d6-dddd-eeee-ffff-000011112222" Name="lwl" NickName="lwl" Description="Waterline length" Optional="False" Access="Item" TypeHint="System.Double" />
          <Parameter InstanceGuid="b4c5d6e7-eeee-ffff-0000-111122223333" Name="beam" NickName="beam" Description="Max beam" Optional="False" Access="Item" TypeHint="System.Double" />
          <Parameter InstanceGuid="c5d6e7f8-ffff-0000-1111-222233334444" Name="draft" NickName="draft" Description="Draft" Optional="False" Access="Item" TypeHint="System.Double" />
          <Parameter InstanceGuid="d6e7f8a9-0000-1111-2222-333344445555" Name="depth" NickName="depth" Description="Depth at sheer" Optional="False" Access="Item" TypeHint="System.Double" />
          <Parameter InstanceGuid="e7f8a9b0-1111-2222-3333-444455556666" Name="station_count" NickName="station_count" Description="Station count" Optional="False" Access="Item" TypeHint="System.Int32" />
          <Parameter InstanceGuid="f8a9b0c1-2222-3333-4444-555566667777" Name="deadrise" NickName="deadrise" Description="Deadrise angle" Optional="True" Access="Item" TypeHint="System.Double" />
          <Parameter InstanceGuid="a9b0c1d2-3333-4444-5555-666677778888" Name="transom_width" NickName="transom_width" Description="Transom width" Optional="True" Access="Item" TypeHint="System.Double" />
          <Parameter InstanceGuid="b0c1d2e3-4444-5555-6666-777788889999" Name="chine_height" NickName="chine_height" Description="Chine height" Optional="True" Access="Item" TypeHint="System.Double" />
          <Parameter InstanceGuid="c1d2e3f4-5555-6666-7777-88889999aaaa" Name="bow_height" NickName="bow_height" Description="Bow height" Optional="True" Access="Item" TypeHint="System.Double" />
        </InputParameters>
        <OutputParameters>
          <Parameter InstanceGuid="d2e3f4a5-6666-7777-8888-9999aaaabbbb" Name="stations" NickName="stations" Description="Station curve IDs" Optional="False" Access="List" TypeHint="Rhino.Geometry.Curve" />
          <Parameter InstanceGuid="e3f4a5b6-7777-8888-9999-aaaabbbbcccc" Name="baseline" NickName="baseline" Description="Baseline curve" Optional="False" Access="Item" TypeHint="Rhino.Geometry.Curve" />
          <Parameter InstanceGuid="f4a5b6c7-8888-9999-aaaa-bbbbccccdddd" Name="centerline" NickName="centerline" Description="Centerline curve" Optional="False" Access="Item" TypeHint="Rhino.Geometry.Curve" />
          <Parameter InstanceGuid="a5b6c7d8-9999-aaaa-bbbb-ccccddddeeee" Name="design_waterline" NickName="design_waterline" Description="Design waterline curve" Optional="False" Access="Item" TypeHint="Rhino.Geometry.Curve" />
        </OutputParameters>
        <ScriptCode><![CDATA[
using System;
using System.Collections.Generic;
using Rhino.Geometry;

private readonly double STERN_BEAM_RATIO = 0.62;
private readonly double BOW_BEAM_RATIO = 0.10;
private readonly int SECTION_SAMPLES = 11;
private readonly double SECTION_POWER = 0.6;

private double ShapeFactor(double t)
{
    if (t <= 0.5)
    {
        double u = t / 0.5;
        return STERN_BEAM_RATIO + (1.0 - STERN_BEAM_RATIO) * Math.Sin(Math.PI * u / 2.0);
    }
    double v = (t - 0.5) / 0.5;
    return BOW_BEAM_RATIO + (1.0 - BOW_BEAM_RATIO) * Math.Cos(Math.PI * v / 2.0);
}

private List<Point3d> SectionPoints(double x, double halfBeam, double draft, double depth)
{
    var pts = new List<Point3d>();
    double top = depth - draft;
    
    // Port side (sheer to keel)
    for (int k = 0; k < SECTION_SAMPLES; k++)
    {
        double s = (double)k / (SECTION_SAMPLES - 1);
        double y = halfBeam * Math.Pow(s, SECTION_POWER);
        double z = -draft + s * top;
        pts.Add(new Point3d(x, -y, z));
    }
    
    // Starboard side (keel to sheer)
    for (int k = SECTION_SAMPLES - 1; k >= 0; k--)
    {
        double s = (double)k / (SECTION_SAMPLES - 1);
        double y = halfBeam * Math.Pow(s, SECTION_POWER);
        double z = -draft + s * top;
        pts.Add(new Point3d(x, y, z));
    }
    
    return pts;
}

private void RunScript(double loa, double lwl, double beam, double draft, double depth, int station_count, 
                       double deadrise, double transom_width, double chine_height, double bow_height,
                       ref object stations, ref object baseline, ref object centerline, ref object design_waterline)
{
    int n = Math.Max(10, Math.Min(20, station_count));
    var stationCurves = new List<Curve>();
    double maxHalfBeam = beam / 2.0;

    for (int i = 0; i < n; i++)
    {
        double t = (double)i / (n - 1);
        double x = t * loa;
        double localBeam = ShapeFactor(t) * beam;
        double halfBeam = localBeam / 2.0;
        
        var pts = SectionPoints(x, halfBeam, draft, depth);
        var curve = NurbsCurve.Create(false, 3, pts);
        if (curve != null) stationCurves.Add(curve);
    }

    // Reference curves
    var baselineCurve = new LineCurve(new Point3d(0, 0, -draft), new Point3d(loa, 0, -draft));
    var centerlineCurve = new LineCurve(new Point3d(0, 0, 0), new Point3d(loa, 0, 0));
    var dwlCurve = new LineCurve(new Point3d(loa/2, -maxHalfBeam, 0), new Point3d(loa/2, maxHalfBeam, 0));

    stations = stationCurves;
    baseline = baselineCurve;
    centerline = centerlineCurve;
    design_waterline = dwlCurve;
}
]]></ScriptCode>
      </MutualData>
    </Fields>
