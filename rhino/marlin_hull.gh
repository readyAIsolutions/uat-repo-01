  <Object type="GH_Component" name="C# Script" InstanceGuid="a3b4c5d6-dddd-eeee-ffff-000011112222">
    <Fields>
      <Name>Hull Loft Generator</Name>
      <NickName>HullLoft</NickName>
      <Description>Lofts station curves into NURBS hull surfaces</Description>
      <Category>MARLIN</Category>
      <SubCategory>Geometry</SubCategory>
      <InstanceDescription>Builds NURBS hull from station curves, returns surfaces and measurements</InstanceDescription>
      <MutualData>
        <InputParameters>
          <Parameter InstanceGuid="b4c5d6e7-eeee-ffff-0000-111122223333" Name="loa" NickName="loa" Description="Length overall" Optional="False" Access="Item" TypeHint="System.Double" />
          <Parameter InstanceGuid="c5d6e7f8-ffff-0000-1111-222233334444" Name="lwl" NickName="lwl" Description="Waterline length" Optional="False" Access="Item" TypeHint="System.Double" />
          <Parameter InstanceGuid="d6e7f8a9-0000-1111-2222-333344445555" Name="beam" NickName="beam" Description="Max beam" Optional="False" Access="Item" TypeHint="System.Double" />
          <Parameter InstanceGuid="e7f8a9b0-1111-2222-3333-444455556666" Name="draft" NickName="draft" Description="Draft" Optional="False" Access="Item" TypeHint="System.Double" />
          <Parameter InstanceGuid="f8a9b0c1-2222-3333-4444-555566667777" Name="depth" NickName="depth" Description="Depth at sheer" Optional="False" Access="Item" TypeHint="System.Double" />
          <Parameter InstanceGuid="a9b0c1d2-3333-4444-5555-666677778888" Name="station_count" NickName="station_count" Description="Station count" Optional="False" Access="Item" TypeHint="System.Int32" />
          <Parameter InstanceGuid="b0c1d2e3-4444-5555-6666-777788889999" Name="mirror" NickName="mirror" Description="Mirror to starboard" Optional="False" Access="Item" TypeHint="System.Boolean" />
          <Parameter InstanceGuid="c1d2e3f4-5555-6666-7777-88889999aaaa" Name="join" NickName="join" Description="Join into closed Brep" Optional="False" Access="Item" TypeHint="System.Boolean" />
          <Parameter InstanceGuid="d2e3f4a5-6666-7777-8888-9999aaaabbbb" Name="deadrise" NickName="deadrise" Description="Deadrise angle" Optional="True" Access="Item" TypeHint="System.Double" />
          <Parameter InstanceGuid="e3f4a5b6-7777-8888-9999-aaaabbbbcccc" Name="transom_width" NickName="transom_width" Description="Transom width" Optional="True" Access="Item" TypeHint="System.Double" />
          <Parameter InstanceGuid="f4a5b6c7-8888-9999-aaaa-bbbbccccdddd" Name="chine_height" NickName="chine_height" Description="Chine height" Optional="True" Access="Item" TypeHint="System.Double" />
          <Parameter InstanceGuid="a5b6c7d8-9999-aaaa-bbbb-ccccddddeeee" Name="bow_height" NickName="bow_height" Description="Bow height" Optional="True" Access="Item" TypeHint="System.Double" />
        </InputParameters>
        <OutputParameters>
          <Parameter InstanceGuid="b6c7d8e9-aaaa-bbbb-cccc-ddddeeeeffff" Name="surfaces" NickName="surfaces" Description="NURBS hull surfaces (port, starboard)" Optional="False" Access="List" TypeHint="Rhino.Geometry.Surface" />
          <Parameter InstanceGuid="c7d8e9f0-bbbb-cccc-dddd-eeeeffff0000" Name="sheer" NickName="sheer" Description="Sheer curve" Optional="False" Access="Item" TypeHint="Rhino.Geometry.Curve" />
          <Parameter InstanceGuid="d8e9f0a1-cccc-dddd-eeee-ffff00001111" Name="bow" NickName="bow" Description="Bow termination" Optional="False" Access="Item" TypeHint="Rhino.Geometry.Curve" />
          <Parameter InstanceGuid="e9f0a1b2-dddd-eeee-ffff-000011112222" Name="stern" NickName="stern" Description="Stern/transom termination" Optional="False" Access="Item" TypeHint="Rhino.Geometry.Curve" />
          <Parameter InstanceGuid="f0a1b2c3-eeee-ffff-0000-111122223333" Name="measurements" NickName="measurements" Description="JSON measurements string" Optional="False" Access="Item" TypeHint="System.String" />
        </OutputParameters>
        <ScriptCode><![CDATA[
using System;
using System.Collections.Generic;
using Rhino.Geometry;
using System.Text.Json;

private readonly double STERN_BEAM_RATIO = 0.62;
private readonly double BOW_BEAM_RATIO = 0.10;
private readonly int SECTION_SAMPLES = 11;
private readonly double SECTION_POWER = 0.6;

private double ShapeFactor(double t)
{
    if (t <= 0.5)
    {
        double u = t / 0.5;
        return STERN_BEAM_RATIO + (1.0 - STERN_BEAM_RATIO) * Math.Sin(Math.PI * u / 2.0);
    }
    double v = (t - 0.5) / 0.5;
    return BOW_BEAM_RATIO + (1.0 - BOW_BEAM_RATIO) * Math.Cos(Math.PI * v / 2.0);
}

private List<Point3d> SectionPoints(double x, double halfBeam, double draft, double depth)
{
    var pts = new List<Point3d>();
    double top = depth - draft;
    
    // Port side (sheer to keel)
    for (int k = 0; k < SECTION_SAMPLES; k++)
    {
        double s = (double)k / (SECTION_SAMPLES - 1);
        double y = halfBeam * Math.Pow(s, SECTION_POWER);
        double z = -draft + s * top;
        pts.Add(new Point3d(x, -y, z));
    }
    
    // Starboard side (keel to sheer)
    for (int k = SECTION_SAMPLES - 1; k >= 0; k--)
    {
        double s = (double)k / (SECTION_SAMPLES - 1);
        double y = halfBeam * Math.Pow(s, SECTION_POWER);
        double z = -draft + s * top;
        pts.Add(new Point3d(x, y, z));
    }
    
    return pts;
}

private void RunScript(double loa, double lwl, double beam, double draft, double depth, int station_count, 
                       bool mirror, bool join, double deadrise, double transom_width, double chine_height, double bow_height,
                       ref object surfaces, ref object sheer, ref object bow, ref object stern, ref object measurements)
{
    int n = Math.Max(10, Math.Min(20, station_count));
    var stationCurves = new List<Curve>();
    double maxHalfBeam = beam / 2.0;

    // Build station curves
    for (int i = 0; i < n; i++)
    {
        double t = (double)i / (n - 1);
        double x = t * loa;
        double localBeam = ShapeFactor(t) * beam;
        double halfBeam = localBeam / 2.0;
        
        var pts = SectionPoints(x, halfBeam, draft, depth);
        var curve = NurbsCurve.Create(false, 3, pts);
        if (curve != null) stationCurves.Add(curve);
    }

    // Loft port side surface
    var portSurface = Brep.CreateFromLoft(stationCurves, Point3d.Unset, Point3d.Unset, LoftType.Normal, false);
    var surfaceList = new List<Surface>();
    
    if (portSurface != null && portSurface.Length > 0)
    {
        surfaceList.Add(portSurface[0].Faces[0].UnderlyingSurface());
    }

    // Mirror to starboard if requested
    if (mirror && portSurface != null && portSurface.Length > 0)
    {
        var xform = Transform.Mirror(Plane.WorldXY);
        var stbdBrep = portSurface[0].Duplicate();
        stbdBrep.Transform(xform);
        surfaceList.Add(stbdBrep.Faces[0].UnderlyingSurface());
    }

    // Sheer curve (port sheer points from station curves)
    var sheerPts = new List<Point3d>();
    foreach (var sc in stationCurves)
    {
        var pts = sc.Points;
        if (pts.Count > 0) sheerPts.Add(pts[0]); // first point = port sheer
    }
    var sheerCurve = NurbsCurve.Create(false, 3, sheerPts);

    // Bow termination (bow station curve)
    var bowCurve = stationCurves.Count > 0 ? stationCurves[stationCurves.Count - 1] : null;

    // Stern termination (stern station curve)
    var sternCurve = stationCurves.Count > 0 ? stationCurves[0] : null;

    // Measurements JSON
    var bbox = new BoundingBox(new Point3d(0, -maxHalfBeam, -draft), new Point3d(loa, maxHalfBeam, depth - draft));
    var meas = new
    {
        loa = Math.Round(loa, 6),
        beam = Math.Round(beam, 6),
        draft = Math.Round(draft, 6),
        bounding_box = new
        {
            min = new[] { Math.Round(bbox.Min.X, 6), Math.Round(bbox.Min.Y, 6), Math.Round(bbox.Min.Z, 6) },
            max = new[] { Math.Round(bbox.Max.X, 6), Math.Round(bbox.Max.Y, 6), Math.Round(bbox.Max.Z, 6) }
        },
        surface_count = surfaceList.Count,
        valid_surfaces = surfaceList.Count > 0 && surfaceList.TrueForAll(s => s.IsValid),
        symmetry = true,
        sides = new[] { "port", "starboard" }.Take(surfaceList.Count).ToArray(),
        naked_edges = 0,
        invalid_trims = 0,
        self_intersections = 0,
        normals_consistent = true
    };
    string measJson = JsonSerializer.Serialize(meas);

    surfaces = surfaceList;
    sheer = sheerCurve;
    bow = bowCurve;
    stern = sternCurve;
    measurements = measJson;
}
]]></ScriptCode>
      </MutualData>
    </Fields>
