# MARLIN env template — copy to .env and edit. NEVER commit .env.
MARLIN_ENVIRONMENT=production
MARLIN_LOG_LEVEL=INFO

# Rhino.Compute node. On the Dell the node is LOCAL to Windows; from a
# container use host.docker.internal (see docker-compose). From the Linux dev
# box use the Dell's LAN address, e.g. http://192.168.1.50:6500  (NOT localhost).
MARLIN_RHINO_URL=http://host.docker.internal:6500
RHINO_COMPUTE_URL=http://host.docker.internal:6500
RHINO_COMPUTE_API_KEY=
RHINO_COMPUTE_TIMEOUT=10
RHINO_COMPUTE_MAX_ATTEMPTS=3
RHINO_COMPUTE_BACKOFF_SECONDS=0

# Server-side Grasshopper definition pointers (see docs/rhino-mvp/MARLIN_HULL.md)
RHINO_STATION_DEFINITION=marlin_station_curves
RHINO_HULL_DEFINITION=marlin_hull
RHINO_BOX_DEFINITION=marlin_box

# Where generated .3dm files are written (volume-backed in Docker)
MARLIN_STORAGE_DIR=storage

# --- Module 10 (image-to-3D) — ADDITIVE; see docs/rhino-mvp/SECTION_10.md ---
# Provider: trellis (real AI engine, needs GPU host) | mock (dev-only,
# hard-blocked when MARLIN_ENVIRONMENT=production).
RECONSTRUCTION_PROVIDER=trellis
# Python of the TRELLIS conda env on the GPU host (e.g. C:\MARLIN\trellis\python.exe)
RECONSTRUCTION_TRELLIS_PYTHON=
# Hugging Face model id (default microsoft/TRELLIS-image-large)
RECONSTRUCTION_TRELLIS_MODEL=microsoft/TRELLIS-image-large
# Upload limits
RECONSTRUCTION_MAX_IMAGES=10
RECONSTRUCTION_MAX_IMAGE_MB=10
